<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- Versions centralisées des packages -->
  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Update="Microsoft.EntityFrameworkCore" Version="8.0.1" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.1" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Tools" Version="8.0.1" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="8.0.1" />
    
    <!-- MediatR (CQRS) -->
    <PackageReference Update="MediatR" Version="12.2.0" />
    
    <!-- FluentValidation -->
    <PackageReference Update="FluentValidation" Version="11.9.0" />
    <PackageReference Update="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    
    <!-- BCrypt -->
    <PackageReference Update="BCrypt.Net-Next" Version="4.0.3" />
    
    <!-- Serilog -->
    <PackageReference Update="Serilog" Version="3.1.1" />
    <PackageReference Update="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Update="Serilog.Sinks.Console" Version="5.0.1" />
    
    <!-- Tests -->
    <PackageReference Update="xunit" Version="2.6.4" />
    <PackageReference Update="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Update="FluentAssertions" Version="6.12.0" />
    <PackageReference Update="Moq" Version="4.20.70" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>
</Project>